# Copy this file to .env and fill in your own keys for local runs.
# The real .env is gitignored. In GitHub Actions these are provided as
# repository secrets instead (Settings -> Secrets and variables -> Actions).

# Adzuna — free app id + key: https://developer.adzuna.com
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Reed — free key (optional): https://www.reed.co.uk/developers
REED_API_KEY=your-reed-api-key
